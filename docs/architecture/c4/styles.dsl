styles {
    element "Person" {
        shape Person
        background "#1F4E79"
        color "#FFFFFF"
    }
    element "External" {
        background "#F3F4F6"
        color "#24313B"
        stroke "#6B7280"
    }
    element "CortexWeave" {
        background "#0F766E"
        color "#FFFFFF"
        stroke "#115E59"
    }
    element "Application" {
        background "#DDF4F1"
        color "#12312E"
        stroke "#0F766E"
    }
    element "Adapter" {
        background "#E0EEFB"
        color "#173A5E"
        stroke "#2D6EA3"
    }
    element "SourceIntelligence" {
        background "#EAF6E8"
        color "#214B27"
        stroke "#4E7B52"
    }
    element "Indexing" {
        background "#DFF2E3"
        color "#214B27"
        stroke "#39734A"
    }
    element "Structural" {
        background "#EFE7F7"
        color "#44215C"
        stroke "#79519D"
    }
    element "Derived" {
        opacity 80
    }
    element "Retrieval" {
        background "#FFF1D6"
        color "#62430F"
        stroke "#B8791B"
    }
    element "Context" {
        background "#FCE7C3"
        color "#62430F"
        stroke "#B8791B"
    }
    element "State" {
        background "#E8EEF5"
        color "#233142"
        stroke "#546A7B"
    }
    element "Experience" {
        background "#FBE8EA"
        color "#65232E"
        stroke "#A44A58"
    }
    element "Historical" {
        opacity 78
    }
    element "Persistence" {
        shape Cylinder
        background "#D8F0F1"
        color "#173C3E"
        stroke "#287075"
    }
    element "Authoritative" {
        border solid
        strokeWidth 3
    }
    relationship "Relationship" {
        color "#526875"
        thickness 2
        fontSize 18
    }
}
